generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String?   @unique
  username           String?   @unique
  password           String?
  name               String
  role               String?
  roles              String[]  @default([])
  isEmailVerified      Boolean   @default(false)
  emailVerifyToken     String?   @unique
  emailVerifyExpires   DateTime?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  googleId             String?   @unique
  profilePicture     String?
  bio                String?
  
  // Teacher-specific fields
  teachingSubjects   String[]
  yearsExperience    Int?
  qualifications     String?
  specialization     String?
  
  // Parent-specific fields
  phone              String?
  preferredContact   String?
  
  // Admin flags
  isAdmin            Boolean   @default(false)
  isSuperAdmin       Boolean   @default(false)
  isManaged          Boolean   @default(false)
  slug               String?   @unique

  // Notification preferences
  emailNotifications         Boolean   @default(true)
  lastNotificationEmailAt    DateTime?

  // Timestamps
  createdAt          DateTime  @default(now())

  // Student-specific fields (via Student model relation)
  interests          String[]
  favoriteSubject    String?
  learningGoals      String?

  student                    Student?
  teacherAssignments         Assignment[]
  teacherMaterials           Material[]
  teacherSessions            Session[]
  teacherFeedback            Feedback[]
  teacherSchedules           Schedule[]                  @relation("TeacherSchedules")
  tutorRequests              TutorRequest[]              @relation("TeacherRequests")
  parentInvites              StudentInvite[]
  parentPayments             Payment[]                   @relation("ParentPayments")
  teacherPayments            Payment[]                   @relation("TeacherPayments")
  parentTutorRequests        TutorRequest[]              @relation("ParentRequests")
  parentControls             ParentalControl[]
  parentRatings              TutorRating[]               @relation("ParentRatings")
  teacherRatings             TutorRating[]               @relation("TeacherRatings")
  teacherEarnings            Earnings[]
  sentMessages               Message[]                   @relation("SentMessages")
  receivedMessages           Message[]                   @relation("ReceivedMessages")
  teacherReports             ProgressReport[]
  teacherStudentAssignments  TeacherStudentAssignment[]
  authSessions               AuthSession[]
  teacherClassrooms          Classroom[]                 @relation("TeacherClassrooms")
  teacherGradeFolders        GradeFolder[]               @relation("TeacherGradeFolders")
  classroomPosts             ClassroomPost[]             @relation("ClassroomPostAuthor")
  notifications              Notification[]
  seenContent                ClassroomContentSeen[]
  childTeamMemberships       ChildTeamMember[]           @relation("TeamMemberUser")
  childTeamInvitesSent       ChildTeamMember[]           @relation("TeamInvitedBy")
  assignmentDrafts           AssignmentDraft[]           @relation("TeacherAssignmentDrafts")

  @@index([email])
  @@index([googleId])
  @@index([emailVerifyToken])
  @@index([passwordResetToken])
}

model Student {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  name       String
  gradeLevel String
  badges     String[]
  points     Int      @default(0)

  user                       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments                StudentAssignment[]
  schedules                  Schedule[]
  feedback                   Feedback[]
  attendance                 Attendance[]
  clarifications             Clarification[]
  parentalControls           ParentalControl[]
  progressReports            ProgressReport[]
  teacherStudentAssignments  TeacherStudentAssignment[]
  classroomEnrollments       ClassroomEnrollment[]
  classroomSubmissions       ClassroomSubmission[]
  childTeamMembers           ChildTeamMember[]          @relation("ChildTeamChild")
  threadMessages             Message[]
  submissionDrafts           SubmissionDraft[]

  @@index([userId])
}

model ChildTeamMember {
  id              Int       @id @default(autoincrement())
  childId         Int
  parentId        Int?
  role            String    @default("owner")
  status          String    @default("active")
  invitedBy       Int?
  inviteToken     String?   @unique
  inviteEmail     String?
  inviteExpiresAt DateTime?
  invitedAt       DateTime  @default(now())
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  child           Student   @relation("ChildTeamChild", fields: [childId], references: [id], onDelete: Cascade)
  parent          User?     @relation("TeamMemberUser", fields: [parentId], references: [id], onDelete: Cascade)
  inviter         User?     @relation("TeamInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([childId, parentId])
  @@index([childId])
  @@index([parentId])
  @@index([inviteToken])
  @@map("child_team_members")
}

model Assignment {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  subject     String
  dueDate     String
  teacherId   Int
  gradeLevel  String
  points      Int     @default(100)
  fileUrl     String?
  slug        String? @unique

  teacher            User                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentAssignments StudentAssignment[]
  clarifications     Clarification[]

  @@index([teacherId])
  @@index([gradeLevel])
}

model StudentAssignment {
  id           Int     @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  submission   String?
  fileUrl      String?
  notes        String?
  grade        Int?
  feedback     String?
  status       String  @default("pending")
  submittedAt  String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([studentId])
}

model Material {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  fileUrl     String
  subject     String
  teacherId   Int
  uploadDate  String
  gradeLevel  String
  slug        String? @unique

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([gradeLevel])
}

model Schedule {
  id        Int    @id @default(autoincrement())
  teacherId Int
  studentId Int
  dayOfWeek String
  startTime String
  endTime   String
  subject   String

  teacher User    @relation("TeacherSchedules", fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([studentId])
}

model Session {
  id          Int     @id @default(autoincrement())
  teacherId   Int
  studentIds  Int[]
  title       String?
  description String?
  subject     String
  sessionDate String  @default("")
  startTime   String
  endTime     String
  meetingUrl  String?
  notes       String?
  status      String  @default("scheduled")

  teacher    User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attendance Attendance[]

  @@index([teacherId])
}

model Feedback {
  id        Int    @id @default(autoincrement())
  teacherId Int
  studentId Int
  message   String
  date      String
  type      String

  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([studentId])
}

model Attendance {
  id        Int     @id @default(autoincrement())
  studentId Int
  sessionId Int?
  date      String
  status    String
  notes     String?

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([sessionId])
}

model Payment {
  id               Int     @id @default(autoincrement())
  parentId         Int
  teacherId        Int?
  amount           Float
  date             String
  status           String
  description      String
  subscriptionType String?

  parent  User  @relation("ParentPayments", fields: [parentId], references: [id], onDelete: Cascade)
  teacher User? @relation("TeacherPayments", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([teacherId])
}

model TutorRequest {
  id           Int     @id @default(autoincrement())
  parentId     Int
  teacherId    Int
  studentId    Int?
  status       String  @default("pending")
  message      String
  requestDate  String
  responseDate String?

  parent  User @relation("ParentRequests", fields: [parentId], references: [id], onDelete: Cascade)
  teacher User @relation("TeacherRequests", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([teacherId])
}

model Message {
  id               Int     @id @default(autoincrement())
  senderId         Int
  receiverId       Int
  message          String
  timestamp        String
  isRead           Boolean @default(false)
  studentId        Int?
  conversationType String  @default("student")

  sender   User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  student  Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([studentId])
  @@index([conversationType])
}

model ProgressReport {
  id           Int   @id @default(autoincrement())
  studentId    Int
  teacherId    Int
  period       String
  content      String
  date         String
  grades       Json
  semesterData Json?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([teacherId])
}

model Clarification {
  id           Int     @id @default(autoincrement())
  studentId    Int
  assignmentId Int
  question     String
  answer       String?
  askedDate    String
  answeredDate String?
  status       String  @default("pending")

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([assignmentId])
}

model ParentalControl {
  id              Int      @id @default(autoincrement())
  studentId       Int      @unique
  parentId        Int
  screenTimeLimit Int?
  allowedDays     String[]
  allowedTimes    Json
  blockedFeatures String[]

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
}

model TutorRating {
  id        Int     @id @default(autoincrement())
  parentId  Int
  teacherId Int?
  rating    Int
  review    String?
  date      String

  parent  User  @relation("ParentRatings", fields: [parentId], references: [id], onDelete: Cascade)
  teacher User? @relation("TeacherRatings", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([teacherId])
}

model Earnings {
  id          Int    @id @default(autoincrement())
  teacherId   Int
  amount      Float
  date        String
  source      String
  description String

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

model StudentInvite {
  id          Int    @id @default(autoincrement())
  parentId    Int
  email       String
  studentName String
  gradeLevel  String
  token       String @unique
  code        String @unique
  status      String @default("pending")
  createdDate String
  expiresDate String

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([token])
  @@index([code])
}

model SystemSettings {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       String
  description String?

  @@index([key])
}

model TeacherStudentAssignment {
  id           Int    @id @default(autoincrement())
  teacherId    Int
  studentId    Int
  assignedDate String
  status       String @default("active")

  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@index([teacherId])
  @@index([studentId])
}

model ThreadLabel {
  id            Int    @id @default(autoincrement())
  teacherUserId Int
  studentId     Int
  name          String

  @@unique([teacherUserId, studentId])
  @@index([teacherUserId])
  @@index([studentId])
}

model AuthSession {
  id                  String   @id
  userId              Int
  expiresAt           DateTime
  impersonatingUserId Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Classrooms ────────────────────────────────────────────────────────────

model GradeFolder {
  id        Int        @id @default(autoincrement())
  name      String
  teacherId Int
  slug      String?    @unique
  createdAt DateTime   @default(now())

  teacher    User        @relation("TeacherGradeFolders", fields: [teacherId], references: [id], onDelete: Cascade)
  classrooms Classroom[]

  @@index([teacherId])
}

model Classroom {
  id            Int       @id @default(autoincrement())
  name          String
  subject       String
  description   String?
  teacherId     Int
  status        String    @default("active")
  slug          String?   @unique
  createdAt     DateTime  @default(now())
  gradeFolderId Int?
  deletedAt     DateTime?

  teacher         User                  @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  gradeFolder     GradeFolder?          @relation(fields: [gradeFolderId], references: [id], onDelete: SetNull)
  enrollments       ClassroomEnrollment[]
  posts             ClassroomPost[]
  assignments       ClassroomAssignment[]
  materials         ClassroomMaterial[]
  gradingPolicies   GradingPolicy[]
  submissionDrafts  SubmissionDraft[]
  assignmentDrafts  AssignmentDraft[]     @relation("ClassroomAssignmentDrafts")

  @@index([teacherId])
  @@index([slug])
  @@index([gradeFolderId])
}

model ClassroomEnrollment {
  id          Int      @id @default(autoincrement())
  classroomId Int
  studentId   Int
  enrolledAt  DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
  @@index([classroomId])
  @@index([studentId])
}

model ClassroomPost {
  id          Int      @id @default(autoincrement())
  classroomId Int
  authorId    Int
  content     String
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  author    User      @relation("ClassroomPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([classroomId])
  @@index([authorId])
}

model ClassroomAssignment {
  id             Int      @id @default(autoincrement())
  classroomId    Int
  title          String
  description    String
  dueDate        String
  points         Int      @default(100)
  assignmentType String   @default("assignment")
  fileUrl        String?
  linkUrl        String?
  slug           String?
  formSchema     Json?
  answerKey      Json?
  createdAt      DateTime @default(now())

  classroom        Classroom                    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  submissions      ClassroomSubmission[]
  materialLinks    ClassroomAssignmentMaterial[]
  submissionDrafts SubmissionDraft[]

  @@unique([classroomId, slug])
  @@index([classroomId])
}

model ClassroomSubmission {
  id           Int     @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  content      String?
  fileUrl      String?
  formAnswers  Json?
  status       String  @default("pending")
  submittedAt  String?
  grade        Int?
  feedback     String?
  returnNote   String?

  assignment ClassroomAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

model ClassroomMaterial {
  id           Int      @id @default(autoincrement())
  classroomId  Int
  title        String
  description  String
  url          String?
  attachments  String[]
  slug         String?
  uploadedAt   DateTime @default(now())

  classroom       Classroom                    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  assignmentLinks ClassroomAssignmentMaterial[]

  @@unique([classroomId, slug])
  @@index([classroomId])
}

model ClassroomAssignmentMaterial {
  assignmentId Int
  materialId   Int

  assignment ClassroomAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  material   ClassroomMaterial   @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([assignmentId, materialId])
  @@index([materialId])
}

// ─── Content seen tracking ──────────────────────────────────────────────────

model ClassroomContentSeen {
  id          Int      @id @default(autoincrement())
  userId      Int
  contentType String
  contentId   Int
  seenAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId])
  @@index([userId, contentType])
}

// ─── Notifications ─────────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// ─── Drafts ──────────────────────────────────────────────────────────────────

model SubmissionDraft {
  id          Int      @id @default(autoincrement())
  studentId   Int
  assignmentId Int
  classroomId Int
  content     String   @default("")
  formAnswers Json?
  savedAt     DateTime @updatedAt

  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment ClassroomAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classroom  Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([studentId, assignmentId])
  @@index([studentId])
  @@index([assignmentId])
  @@map("submission_drafts")
}

model AssignmentDraft {
  id               Int      @id @default(autoincrement())
  teacherId        Int
  classroomId      Int
  assignmentId     Int?
  title            String   @default("")
  description      String   @default("")
  dueDate          String   @default("")
  points           Int      @default(100)
  assignmentType   String   @default("")
  linkUrl          String?
  formSchema       Json?
  answerKey        Json?
  linkedMaterialIds Int[]   @default([])
  savedAt          DateTime @updatedAt

  teacher   User      @relation("TeacherAssignmentDrafts", fields: [teacherId], references: [id], onDelete: Cascade)
  classroom Classroom @relation("ClassroomAssignmentDrafts", fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classroomId, assignmentId])
  @@index([teacherId])
  @@index([classroomId])
  @@map("assignment_drafts")
}

// ─── Grading Policy ──────────────────────────────────────────────────────────

model GradingPolicy {
  id               Int      @id @default(autoincrement())
  classroomId      Int
  assignmentWeight Int      @default(25)
  testWeight       Int      @default(25)
  quizWeight       Int      @default(25)
  projectWeight    Int      @default(25)
  effectiveFrom    DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId])
}
